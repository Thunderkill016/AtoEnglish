{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-reminder",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 1 * * 1"
    }
  ]
}
