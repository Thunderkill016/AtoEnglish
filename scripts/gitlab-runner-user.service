[Unit]
Description=GitLab Runner (user, AtoEnglish self-hosted)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/gitlab-runner
ExecStart=%h/gitlab-runner/gitlab-runner run --config %h/gitlab-runner/config.toml
Restart=always
RestartSec=15

[Install]
WantedBy=default.target