#!/usr/bin/env sh
# .husky/post-push
# Runs after every `git push` — monitors the Vercel deployment in background.
# Only runs on main branch pushes (where Vercel deploys from).

BRANCH=$(git branch --show-current 2>/dev/null || echo "")

if [ "$BRANCH" = "main" ]; then
  echo ""
  echo "🚀 Pushed to main — monitoring Vercel deployment..."
  echo "   Run 'npm run check-deploy' to see live status."
  echo "   Or check: https://vercel.com/thunderkill016/atoenglish"
  echo ""

  # Run check in background — non-blocking, output to temp log
  LOG_FILE="/tmp/vercel-deploy-$(date +%s).log"
  (
    cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0
    if [ -n "${VERCEL_TOKEN:-}" ] || grep -q "VERCEL_TOKEN=" .env.local 2>/dev/null; then
      npm run check-deploy > "$LOG_FILE" 2>&1
      STATUS=$?
      if [ $STATUS -eq 0 ]; then
        # Desktop notification on success (Linux/macOS)
        command -v notify-send > /dev/null 2>&1 && \
          notify-send "✅ AtoEnglish deployed!" "Vercel deployment succeeded" --icon=terminal 2>/dev/null || true
        echo "✅ Vercel: DEPLOYED — check $LOG_FILE"
      else
        command -v notify-send > /dev/null 2>&1 && \
          notify-send "❌ AtoEnglish deploy FAILED" "Check terminal for build errors" --icon=dialog-error --urgency=critical 2>/dev/null || true
        echo ""
        echo "❌ =========================================="
        echo "❌  VERCEL BUILD FAILED! Fix before moving on"
        echo "❌ =========================================="
        cat "$LOG_FILE"
      fi
    fi
  ) &

  # Don't block the shell — git push already completed
  disown 2>/dev/null || true
fi
