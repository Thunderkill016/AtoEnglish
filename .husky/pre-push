#!/usr/bin/env sh
# Block push of commits whose author email is not a Vercel team member.
# Without this, production deploys get readyState=BLOCKED:
#   "no git user associated with the commit" / COMMIT_AUTHOR_REQUIRED

ALLOWED_EMAILS='thunderkill016@gmail.com
66909862+Thunderkill016@users.noreply.github.com'

# Commits that will be on the remote after this push (range may be empty for new branches)
RANGE=""
if [ -n "$1" ] && [ -n "$2" ]; then
  # husky may not pass refs; fall back to @{u}..HEAD
  :
fi

if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then
  RANGE="@{u}..HEAD"
else
  # first push of branch — check last 20 commits
  RANGE="HEAD~20..HEAD"
fi

# If no new commits, nothing to check
COMMITS=$(git rev-list "$RANGE" 2>/dev/null || true)
if [ -z "$COMMITS" ]; then
  exit 0
fi

BAD=0
for sha in $COMMITS; do
  email=$(git log -1 --format='%ae' "$sha")
  ok=0
  for allowed in $ALLOWED_EMAILS; do
    if [ "$email" = "$allowed" ]; then
      ok=1
      break
    fi
  done
  if [ "$ok" -eq 0 ]; then
    echo "❌ Commit $(git rev-parse --short "$sha") author email is not allowed for Vercel:"
    echo "   $email  ($(git log -1 --format='%an | %s' "$sha"))"
    BAD=1
  fi
done

if [ "$BAD" -ne 0 ]; then
  echo ""
  echo "Vercel Hobby/team blocks deploys when commit author is not a team member"
  echo "(COMMIT_AUTHOR_REQUIRED → readyState BLOCKED / CLI shows UNKNOWN)."
  echo ""
  echo "Allowed emails:"
  echo "$ALLOWED_EMAILS" | sed 's/^/  - /'
  echo ""
  echo "Fix before push:"
  echo "  git config user.email thunderkill016@gmail.com"
  echo "  git config user.name Thunderkill016"
  echo "  git commit --amend --reset-author --no-edit   # if only HEAD is wrong"
  echo ""
  echo "Never: git -c user.email=thunder@atoenglish.com commit ..."
  exit 1
fi

exit 0
