  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Safari >= 16.4",
      "Firefox >= 128",
      "Edge >= 111",
      "iOS >= 16.4"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Safari version",
      "last 1 Firefox version"
    ]
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  }
