# Supabase Configuration
# Thay thế bằng thông tin thực tế từ Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Curriculum v2 (A0→B1 LessonSpec) — default ON; set 0 for legacy v1 only
NEXT_PUBLIC_CURRICULUM_V2=1

# Upstash Redis — Rate Limiting (Production)
# Đăng ký tại https://upstash.com (free tier: 10k requests/day)
# Dashboard > Create Database > REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# Khi KHÔNG có Upstash (local dev), rate limiting dùng in-memory fallback tự động

# Sentry — Error Monitoring (Production)
# Đăng ký tại https://sentry.io (free tier: 5k errors/month)
# Settings > Projects > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=atoenglish
SENTRY_AUTH_TOKEN=your-auth-token

# Web Push Notifications — VAPID Keys
# Tạo key pair bằng lệnh: npx web-push generate-vapid-keys
# Public key dùng ở client (NEXT_PUBLIC_*), Private key chỉ dùng ở server/Edge Function
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your@email.com
# Sau khi có key, set VAPID_PRIVATE_KEY + VAPID_SUBJECT trong Supabase Dashboard
# > Settings > Edge Functions > Environment Variables
SUPABASE_SERVICE_ROLE_KEY=
